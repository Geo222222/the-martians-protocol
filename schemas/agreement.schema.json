{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://themartiansprotocol.dev/schemas/agreement.schema.json","title":"Agreement Metadata","type":"object","additionalProperties":false,"required":["agreement_id","network_id","party_ids","agreement_type","document_hash","status","privacy"],"properties":{"agreement_id":{"$ref":"common.schema.json#/$defs/agreementId"},"network_id":{"$ref":"common.schema.json#/$defs/networkId"},"party_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"oneOf":[{"$ref":"common.schema.json#/$defs/identityId"},{"$ref":"common.schema.json#/$defs/enterpriseId"}]}},"agreement_type":{"type":"string","minLength":1},"document_hash":{"$ref":"common.schema.json#/$defs/sha256"},"status":{"enum":["DRAFT","ACTIVE","COMPLETED","TERMINATED","SUPERSEDED"]},"privacy":{"$ref":"common.schema.json#/$defs/privacyClass"}}}