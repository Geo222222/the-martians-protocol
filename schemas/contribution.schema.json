{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://themartiansprotocol.dev/schemas/contribution.schema.json","title":"Contribution Record","type":"object","additionalProperties":false,"required":["contribution_id","network_id","contributor_id","recipient_id","contribution_type","description","evidence_refs","privacy"],"properties":{"contribution_id":{"$ref":"common.schema.json#/$defs/contributionId"},"network_id":{"$ref":"common.schema.json#/$defs/networkId"},"contributor_id":{"$ref":"common.schema.json#/$defs/identityId"},"recipient_id":{"oneOf":[{"$ref":"common.schema.json#/$defs/identityId"},{"$ref":"common.schema.json#/$defs/enterpriseId"}]},"contribution_type":{"enum":["LABOR","CAPITAL","INTELLECTUAL_PROPERTY","ENTERPRISE_CREATION","REVENUE_CREATION","MENTORSHIP","CAREGIVING","LEADERSHIP","EDUCATION","PROPERTY","OPPORTUNITY_CREATION","RISK_BEARING"]},"description":{"type":"string","minLength":1},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1}},"valuation_minor_units":{"type":["integer","null"],"minimum":0},"valuation_currency":{"type":["string","null"],"pattern":"^[A-Z]{3}$"},"privacy":{"$ref":"common.schema.json#/$defs/privacyClass"}}}