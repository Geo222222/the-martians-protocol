{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://themartiansprotocol.dev/schemas/event.schema.json","title":"Protocol Event Envelope","type":"object","additionalProperties":false,"required":["event_id","network_id","event_type","actor_id","subject_id","payload","occurred_at","previous_event_hash","payload_hash"],"properties":{"event_id":{"$ref":"common.schema.json#/$defs/eventId"},"network_id":{"$ref":"common.schema.json#/$defs/networkId"},"event_type":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,63}$"},"actor_id":{"oneOf":[{"$ref":"common.schema.json#/$defs/identityId"},{"$ref":"common.schema.json#/$defs/enterpriseId"}]},"subject_id":{"$ref":"common.schema.json#/$defs/protocolId"},"payload":{"type":"object"},"occurred_at":{"type":"string","format":"date-time"},"previous_event_hash":{"anyOf":[{"$ref":"common.schema.json#/$defs/sha256"},{"type":"null"}]},"payload_hash":{"$ref":"common.schema.json#/$defs/sha256"}}}